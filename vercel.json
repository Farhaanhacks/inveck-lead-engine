{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 0 * * 1-5"
    },
    {
      "path": "/api/cron/draw",
      "schedule": "30 2 * * 1-5"
    },
    {
      "path": "/api/cron/inbound-demos",
      "schedule": "15 3 * * *"
    }
  ]
}
