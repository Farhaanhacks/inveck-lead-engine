{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 0 * * 1-5"
    },
    {
      "path": "/api/cron/draw",
      "schedule": "30 2 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "40 0 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "50 0 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "10 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "20 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "30 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "40 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "50 1 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "0 2 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "10 2 * * 1-5"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "20 2 * * 1-5"
    }
  ]
}
